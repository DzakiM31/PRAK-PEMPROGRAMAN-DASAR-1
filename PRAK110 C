#include <stdio.h>
#include <math.h>

int main() {
    int alas = 5;
    int tinggi = 12;

    // Berdasarkan gambar segitiga:
    // Sisi A = Tinggi
    // Sisi C = Alas
    // Sisi B = Miring (Pythagoras)

    int sisi_a = tinggi;
    int sisi_c = alas;
    int sisi_b = 13;

    int keliling = sisi_a + sisi_b + sisi_c;
    int luas = 0.5 * sisi_c * sisi_a;

    printf("Dik:\n");
    printf("Alas = %d cm\n", alas);
    printf("Tinggi = %d cm\n\n", tinggi);
    printf("Jawab:\n");
    printf("Sisi A = %d cm\n", sisi_a);
    printf("Sisi B = %d cm\n", sisi_b);
    printf("Sisi C = %d cm\n", sisi_c);
    printf("Keliling = %d cm\n", keliling);
    printf("Luas = %d cm\n", luas);

    return 0;
}
