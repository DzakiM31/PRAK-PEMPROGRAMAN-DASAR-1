#include <stdio.h>

int main() {
    float val1, val2, hasil;

    printf("Masukkan Nilai Pertama: ");
    scanf("%f", &val1);

    printf("Masukkan Nilai Kedua: ");
    scanf("%f", &val2);

    hasil = val1 + val2;

    printf("Hasil dari penjumlahan nilai pertama \"%.2f\" dan nilai kedua \"%.2f\" adalah \"%.2f\"\n",
           val1, val2, hasil);

    return 0;
}
