#include <stdio.h>

int main() {
    int detik, hari, sisa, jam, menit, d;
    scanf("%d", &detik);

    hari = detik / 86400;
    sisa = detik % 86400;
    jam = sisa / 3600;
    menit = (sisa % 3600) / 60;
    d = sisa % 60;

    if (hari > 0) {
        printf("%d hari %02d:%02d:%02d\n", hari, jam, menit, d);
    } else {
        printf("%02d:%02d:%02d\n", jam, menit, d);
    }
    return 0;
}
