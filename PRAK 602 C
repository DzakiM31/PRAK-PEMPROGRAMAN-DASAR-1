#include <stdio.h>

int main() {
    int n, i, hasil;
    int zetsu[1000];

    scanf("%d", &n);
    for (i = 0; i < n; i++) {
        scanf("%d", &zetsu[i]);
    }

    for (i = 0; i < n; i++) {
        hasil = zetsu[i] * (i + 1);     
        printf("%d", hasil);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    return 0;
}
