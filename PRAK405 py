n = int(input())
k = int(input())

total = 0

for i in range(1, n + 1):              
    jumlah = 0
    for j in range(i, 0, -1):          
        print("(%d * %d)" % (j, k), end="")
        jumlah = jumlah + j * k
        if j != 1:                     
            print(" + ", end="")
    print(" = %d" % jumlah)
    total = total + jumlah

print(total)
