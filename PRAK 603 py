n1, n2 = map(int, input().split())

if n1 != n2:
    print("Jumlah tidak sama")
else:
    baris1 = input().split()
    baris2 = input().split()
    for i in range(n1):
        hasil = int(baris1[i]) * int(baris2[i])
        if i < n1 - 1:
            print(hasil, end=" ")
        else:
            print(hasil)
