#include <stdio.h>
#include <string.h>

int main() {
    char kode[200], pesan[200], hasil[200];
    int i, n, bintang = 0, pagar = 0;

    scanf(" %[^\n]", kode);
    scanf(" %[^\n]", pesan);

    if (strlen(kode) != strlen(pesan)) {
        printf("Panjang kalimat berbeda, pesan palsu\n");
    } else {
        n = strlen(kode);
        for (i = 0; i < n; i++) {
            if (kode[i] == ' ' && pesan[i] == ' ') {   
                hasil[i] = ' ';
            } else if (kode[i] == pesan[i]) {          
                hasil[i] = '*';
                bintang++;
            } else {                                   
                hasil[i] = '#';
                pagar++;
            }
        }
        hasil[n] = '\0';

        printf("%s\n", hasil);
        printf("* = %d\n", bintang);
        printf("# = %d\n", pagar);
        if (bintang >= pagar) {
            printf("Pesan Asli\n");
        } else {
            printf("Pesan Palsu\n");
        }
    }
    return 0;
}
