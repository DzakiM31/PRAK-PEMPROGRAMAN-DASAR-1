#include <stdio.h>

struct Dompet {
    char nama[50];
    int saldo;
};

void topup(struct Dompet *d, int nominal) {
    d->saldo = d->saldo + nominal;
    printf("Top up %d berhasil, saldo = %d\n", nominal, d->saldo);
}

void bayar(struct Dompet *d, int nominal) {
    if (d->saldo >= nominal) {
        d->saldo = d->saldo - nominal;
        printf("Bayar %d berhasil, saldo = %d\n", nominal, d->saldo);
    } else {
        printf("Bayar %d gagal, saldo tidak cukup\n", nominal);
    }
}

int main() {
    struct Dompet w;
    int n, i, nominal;
    char jenis;

    scanf("%s %d", w.nama, &w.saldo);
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf(" %c %d", &jenis, &nominal);
        if (jenis == 'T') {
            topup(&w, nominal);
        } else if (jenis == 'B') {
            bayar(&w, nominal);
        }
    }

    printf("Saldo akhir %s = %d\n", w.nama, w.saldo);
    return 0;
}
