#include <stdio.h>

int main() {
    int harga_a = 400000;
    int harga_b = 350000;

    int harga_setelah_diskon_a = harga_a - (harga_a * 13 / 100);
    int harga_setelah_diskon_b = harga_b - (harga_b * 21 / 100);

    printf("harga sepatu a setelah diskon: %d\n", harga_a);
    printf("harga sepatu b setelah diskon: %d\n", harga_b);
    printf("harga sepatu a setelah diskon: %d\n", harga_setelah_diskon_a);
    printf("harga sepatu b setelah diskon: %d\n", harga_setelah_diskon_b);
    return 0;
}
