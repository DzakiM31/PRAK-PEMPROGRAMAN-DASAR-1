#include <stdio.h>

int main() {
    int n1, n2, i, hasil;
    int baris1[100], baris2[100];

    scanf("%d %d", &n1, &n2);

    if (n1 != n2) {
        printf("Jumlah tidak sama\n");
    } else {
        for (i = 0; i < n1; i++) {
            scanf("%d", &baris1[i]);
        }
        for (i = 0; i < n1; i++) {
            scanf("%d", &baris2[i]);
        }
        for (i = 0; i < n1; i++) {
            hasil = baris1[i] * baris2[i];
            printf("%d", hasil);
            if (i < n1 - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }
    return 0;
}
