#include <stdio.h>

int main() {
    int baris, kolom, i, j;
    int matriks[100][100];
    scanf("%d%d", &baris, &kolom);

    for (i = 0; i < baris; i++) {
        for (j = 0; j < kolom; j++) {
            scanf("%d", &matriks[i][j]);
        }
    }

    for (i = 0; i < baris; i++) {
        for (j = 0; j < kolom; j++) {
            printf("%d ", matriks[i][j]);
            if (j < kolom - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }

    return 0;
}
