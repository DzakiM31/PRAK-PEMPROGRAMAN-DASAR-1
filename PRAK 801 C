#include <stdio.h>

int main(){
    int nilai;
    int *ptr = &nilai;
    scanf("%d", &nilai);

    printf("Nilai variabel = %d\n", nilai);
    printf("Alamat variabel = %p\n", &nilai);
    printf("Nilai melalui pointer = %d\n", *(&nilai));

    *ptr = *ptr * 2;
    printf("Nilai variabel setelah diubah melalui pointer = %d\n", nilai);
    return 0;
}
