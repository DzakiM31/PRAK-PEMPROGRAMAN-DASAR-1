#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char kata[100], kecil[100];
    int i, n, palindrom = 1;

    scanf("%s", kata);
    n = strlen(kata);

    for (i = 0; i < n; i++) {
        kecil[i] = tolower(kata[i]);        
    }
    kecil[n] = '\0';

    for (i = 0; i < n / 2; i++) {
        if (kecil[i] != kecil[n - 1 - i]) { 
            palindrom = 0;
        }
    }

    if (palindrom == 1) {
        printf("Kata '%s' adalah palindrom\n", kata);
    } else {
        printf("Kata '%s' bukan palindrom\n", kata);
    }
    return 0;
}
