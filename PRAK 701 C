#include <stdio.h>
#include <string.h>

int main() {
    char depan[50], belakang[50], lengkap[100];
    int i, panjang = 0;

    printf("Nama Depan : ");
    scanf(" %[^\n]", depan);
    printf("Nama Belakang : ");
    scanf(" %[^\n]", belakang);

    strcpy(lengkap, depan);         
    strcat(lengkap, " ");           
    strcat(lengkap, belakang);      

    for (i = 0; lengkap[i] != '\0'; i++) {
        if (lengkap[i] != ' ') {
            panjang++;
        }
    }

    printf("Nama Lengkap : %s\n", lengkap);
    printf("Panjang Nama (tanpa spasi) : %d\n", panjang);
    return 0;
}
